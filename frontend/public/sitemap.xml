<?xml version="1.0" encoding="UTF-8"?>
<!-- Replace https://www.your-domain.com with your real domain before going live.
     Product pages (/products/:id) can be added here, or generated from the database by the backend. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://www.your-domain.com/</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
  <url><loc>https://www.your-domain.com/products</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
  <url><loc>https://www.your-domain.com/about</loc><changefreq>monthly</changefreq><priority>0.5</priority></url>
  <url><loc>https://www.your-domain.com/contact</loc><changefreq>monthly</changefreq><priority>0.5</priority></url>
  <url><loc>https://www.your-domain.com/login</loc><changefreq>yearly</changefreq><priority>0.3</priority></url>
  <url><loc>https://www.your-domain.com/register</loc><changefreq>yearly</changefreq><priority>0.3</priority></url>
</urlset>
