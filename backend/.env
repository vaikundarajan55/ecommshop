PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db_live
DB_CONN_LIMIT=10

JWT_SECRET=change_this_secret_key
JWT_EXPIRES_IN=1d

CLIENT_ADMIN_URL=http://192.168.1.103:5000
CLIENT_WEBSITE_URL=http://192.168.1.103:5000

PYTHON_AI_SERVICE_URL=http://192.168.1.103:8002

UPLOAD_DIR=uploads

# AI assistant (website account > AI Assistant). Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...   (uncomment and paste your key)
# Optional overrides
# AI_CHAT_MODEL=claude-opus-5
# AI_CHAT_EFFORT=low

# Free AI chat with Google Gemini - get a free key at https://aistudio.google.com/apikey
# (used automatically when set; takes priority over ANTHROPIC_API_KEY)
# GEMINI_API_KEY=AIza...   (uncomment and paste your key)
# GEMINI_MODEL=gemini-2.5-flash
# AI_CHAT_PROVIDER=gemini

# Razorpay online payments (UPI / card / net banking / wallet on the Payment page)
# Test keys (rzp_test_...) from https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Leave empty to turn online payment off (only Cash on Delivery works then)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Built-in demo payment popup while the Razorpay keys above are empty (ignored in production)
PAYMENT_DEMO_MODE=true

# Email (welcome, order confirmation, password reset)
# Leave SMTP_HOST empty in development to use a free Ethereal test inbox (preview links in the console).
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional sender, e.g. "ShopEase" <orders@your-domain.com>
MAIL_FROM=
