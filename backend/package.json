{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Ecommerce backend - Node.js, Express, MVC, Socket.IO, MySQL",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build:frontend": "npm --prefix ../frontend run build",
    "start:full": "npm run build:frontend && node src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 startOrRestart ecosystem.config.cjs --env production --update-env",
    "pm2:stop": "pm2 stop ecommerce",
    "pm2:logs": "pm2 logs ecommerce",
    "deploy": "npm run build:frontend && npm run pm2:restart"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.0",
    "socket.io": "^4.7.5",
    "svg-captcha": "^1.4.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
